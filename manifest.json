{
  "manifest_version": 3,
  "name": "Bahria LMS Redesign",
  "version": "2.1",
  "description": "Modern UI redesign for Bahria University LMS and CMS — clean layout, dark mode, and 12 color themes.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "LMS Redesign Settings",
    "default_icon": {
      "16": "icons/logo.png",
      "48": "icons/logo.png",
      "128": "icons/logo.png"
    }
  },
  "icons": {
    "16": "icons/logo.png",
    "48": "icons/logo.png",
    "128": "icons/logo.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://lms.bahria.edu.pk/*"],
      "css": ["css/theme.css", "css/mystyle.css"],
      "js": ["js/theme-core.js", "js/content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://cms.bahria.edu.pk/*"],
      "css": ["css/theme.css", "css/cms-style.css"],
      "js": ["js/theme-core.js", "js/cms-content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["*://lms.bahria.edu.pk/*", "*://cms.bahria.edu.pk/*"]
    }
  ]
}
